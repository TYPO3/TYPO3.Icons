{
  "name": "@typo3/icons",
  "description": "SVG icons for the TYPO3 CMS backend",
  "version": "5.1.0",
  "keywords": [
    "TYPO3",
    "Icons"
  ],
  "homepage": "http://typo3.github.io/TYPO3.Icons/",
  "author": "The TYPO3.Icons Authors (https://github.com/TYPO3/TYPO3.Icons/graphs/contributors)",
  "contributors": [
    {
      "name": "TYPO3 CMS Core Team",
      "url": "https://forge.typo3.org/projects/typo3cms-core"
    },
    {
      "name": "The TYPO3 Community",
      "url": "https://typo3.org/community/"
    }
  ],
  "readme": "README.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TYPO3/TYPO3.Icons.git"
  },
  "bugs": {
    "url": "https://github.com/TYPO3/TYPO3.Icons/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@stylistic/stylelint-plugin": "^5.3.1",
    "@typo3/soul-frontend": "^0.8.1",
    "clean-css": "^4.2.4",
    "deepmerge": "^4.3.1",
    "http-server": "^14.1.1",
    "js-yaml": "^5.4.3",
    "postcss-scss": "^4.0.9",
    "sass": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-order": "^8.1.1",
    "stylelint-scss": "^7.3.0",
    "svg-sprite": "^2.0.4",
    "svgo": "^2.8.4",
    "twig": "^3.0.0"
  },
  "files": [
    "dist",
    "meta",
    "src",
    "CHANGELOG.md",
    "typo3.json"
  ],
  "sass": "dist/icons.scss",
  "style": "dist/icons.css",
  "scripts": {
    "build": "npm run stylelint && npm run icons-build && npm run version-build && npm run site-build",
    "site-serve": "http-server -c-1 ./_site",
    "site-refresh": "node scripts/task.mjs icons site",
    "site-build": "node scripts/task.mjs site",
    "icons-build": "node scripts/task.mjs icons",
    "version-build": "node scripts/task.mjs version",
    "stylelint": "stylelint assets/scss/*",
    "dev": "node scripts/task.mjs dev",
    "watch": "node scripts/task.mjs watch",
    "preversion": "npm run stylelint",
    "version": "node scripts/task.mjs changelog && git add CHANGELOG.md"
  }
}
