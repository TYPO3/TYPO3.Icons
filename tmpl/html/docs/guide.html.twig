{% extends "_layout.html.twig" %}
{% import "_makros.html.twig" as makros %}
{% block title %}Design guidelines{% endblock %}
{% block content %}

    {%- include '_breadcrumb.html.twig' -%}

    <h1>Icon design guidelines</h1>
    <p class="sds-lead">
        Create icons that feel native to TYPO3. These shared grids, sizes, colors and construction
        rules keep contributions consistent with the icons already used throughout the backend.
    </p>

    {%- include '_toc.html.twig' -%}

    {#- The rhythm between the sections, stated by the container Soul has
        for it. Left to the flow, the air above a heading is a rule on the
        block before it, and a block whose own margin ties with that rule
        wins on source order — a table before a heading closed the two to
        the step a paragraph gets. -#}
    <div class="sds-section">
        <h2>Sizes</h2>

        <div class="preview">
        {%- set sizes = ['mega', 'large', 'medium', 'small', 'default'] -%}
        {%- for size in sizes -%}
            <div class="preview-item" data-color="light" data-size="{{ size }}">
                {%- include '_icon.html.twig' with {
                    iconIdentifier: 'actions-brand-typo3',
                    iconSize: size
                } -%}
            </div>
        {%- endfor -%}
        </div>
        <div class="sds-table-scroll docs-reference">
            <table class="sds-table sds-table--medium">
                <thead>
                    <tr>
                        <th scope="col">Size</th>
                        <th scope="col">Rendered</th>
                    </tr>
                </thead>
                <tbody>
                <tr>
                    <td class="sds-td-meta">default</td>
                    <td>Scales with font-size</td>
                </tr>
                <tr>
                    <td class="sds-td-meta">small</td>
                    <td>16px</td>
                </tr>
                <tr>
                    <td class="sds-td-meta">medium</td>
                    <td>32px</td>
                </tr>
                <tr>
                    <td class="sds-td-meta">large</td>
                    <td>48px</td>
                </tr>
                <tr>
                    <td class="sds-td-meta">mega</td>
                    <td>64px</td>
                </tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="sds-section">
        <h2>Colors</h2>

        {#- The palette an icon may be drawn in, as one list to edit. Literal values
            rather than Soul tokens: these are the icon set's own colours, the same
            in either mode, which is the case `sds-swatch` takes a literal for. The
            hex is repeated as `resolved` because the value is what somebody reading
            this page has come to copy. -#}
        {%- set palette = [
            { name: 'TYPO3 primary color', value: '#FF8700' },
            { name: 'Yellow', value: '#E8A33D' },
            { name: 'Yellow light', value: '#FFC857' },
            { name: 'Gray dark', value: '#515151' },
            { name: 'Gray', value: '#8C8C8C' },
            { name: 'Gray light', value: '#B9B9B9' },
            { name: 'Gray brighter', value: '#EFEFEF' },
            { name: 'Red', value: '#C83C3C' },
            { name: 'Red light', value: '#FF6777' },
            { name: 'Green', value: '#79A548' },
            { name: 'Green light', value: '#AAD400' },
            { name: 'Blue', value: '#5599FF' },
            { name: 'Blue light', value: '#ABD7FF' },
            { name: 'Purple', value: '#663399' }
        ] -%}
        <sds-grid>
            {%- for color in palette -%}
                <sds-swatch value="{{ color.value }}" name="{{ color.name }}" resolved="{{ color.value }}"></sds-swatch>
            {%- endfor -%}
        </sds-grid>
    </div>
    <div class="sds-section">
        <h2>Explore the guidelines</h2>
        <ul>
            <li><a href="{{ pathPrefix }}guide/usage.html">Usage</a> — choose between installation, backend usage and external usage.</li>
            <li><a href="{{ pathPrefix }}guide/drawing.html">Drawing an icon</a> — the construction rules for action and overlay icons.</li>
            <li><a href="{{ pathPrefix }}guide/modules.html">Module icons</a> — the larger canvas the module menu is drawn on.</li>
            <li><a href="{{ pathPrefix }}guide/bidi.html">Bidirectional support</a> — logical naming, and what flips in a right-to-left interface.</li>
            <li><a href="{{ pathPrefix }}guide/contributing.html">Contributing</a> — choosing a contribution path, preparing changes and understanding the review process.</li>
        </ul>
    </div>

{% endblock %}
