{#- The documentation layout: a rail of categories beside a reading column. -#}
<!doctype html>
<html lang="en">
<head>
    <title>{% block title %}{% endblock %} - TYPO3 Icons</title>
    {%- include '_head.html.twig' -%}
</head>
<body class="sds-app">

    <a class="sds-skip sds-btn sds-btn--secondary" href="#main-content">Skip to content</a>

    <div class="sds-shell">

        {%- include '_bar.html.twig' -%}

        <div class="sds-body">
            <aside class="sds-body__rail">
                <sds-nav-rail entry="{{ nav.section|json_encode|e('html_attr') }}"></sds-nav-rail>
            </aside>
            <main class="sds-body__main" id="main-content">
                <div class="sds-prose">
                    {%- block content -%}{%- endblock -%}
                </div>
            </main>
        </div>

        {%- include '_footer.html.twig' -%}

    </div>

</body>
</html>
