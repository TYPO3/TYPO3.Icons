{% extends "_layout.html.twig" %}
{% import "_makros.html.twig" as makros %}
{% block title %}{{ icon.identifier }} - {{ category.title }}{% endblock %}
{% block content %}

    {%- include '_breadcrumb.html.twig' with { leaf: icon.identifier } -%}

    <div class="docs-intro">
        <h1>{{ icon.identifier }}</h1>
        <div class="docs-facts">
            {%- if icon._meta.tags|length > 0 -%}
                <div class="docs-fact"><strong>Tags:</strong> {{ icon._meta.tags|join(', ') }}</div>
            {%- endif -%}
            {%- if icon._meta.bidi -%}
                <div class="docs-fact" title="This icon automatically flips in right-to-left (RTL) languages">
                    <sds-badge tone="accent" label="BiDi"></sds-badge>
                </div>
            {%- endif -%}
            {%- if icon._meta.changes|length > 0 -%}
                <div class="docs-fact">Introduced in <a href="https://github.com/TYPO3/TYPO3.Icons/releases/tag/v{{ icon._meta.changes.0 }}" target="_blank" rel="noopener">v{{ icon._meta.changes.0 }}</a></div>
                {%- set available = false -%}
                {%- for typo3version, version in typo3.versions -%}
                    {%- if version in icon._meta.changes %}{% set available = true %}{% endif -%}
                {%- endfor -%}
                {%- if available -%}
                <div class="docs-fact">
                    Available in TYPO3
                    {% for typo3version, version in typo3.versions %}{% if version in icon._meta.changes %}<sds-badge label="{{ typo3version }}"></sds-badge> {% endif %}{% endfor %}
                </div>
                <div class="docs-fact">
                    <a href="{{ pathPrefix }}guide/compatibility.html">Version compatibility</a>
                </div>
                {%- endif -%}
            {% endif %}
        </div>
    </div>

    {%- if category.identifier in ['actions', 'apps', 'content', 'default', 'form', 'information', 'mimetypes', 'module', 'status', 'spinner'] -%}
        <div class="iconstage"{% if category.identifier in ['module'] %} style="--iconstage-icon-base-size: 32"{% endif %}>
            <div class="iconstage-icon">
                {%- include '_icon.html.twig' with {
                    iconIdentifier: icon.identifier,
                    iconSize: 'auto',
                    iconSpinning: category.rendering.spinning
                } -%}
            </div>
        </div>
    {%- endif -%}

    {%- if 'actions-brand' in icon.identifier -%}
        <sds-note tone="warn" heading="Trademark">
            <p>This work includes material that may be protected as a trademark in some jurisdictions. If you want to use it, you have to ensure that you have the legal right to do so and that you do not infringe any trademark rights.</p>
            <p>The use of these trademarks does not indicate endorsement of the trademark holder by TYPO3, nor vice versa. See the trademark owner for rules about appropriate use of their trademarks.</p>
        </sds-note>
    {%- endif -%}

    {#- The rhythm between the sections, stated once. Each box carried
        `class="section"`, which nothing in this build defines — so the
        sections had no distance at all, and every `h2` inside one was cut
        off from the block that states the air above it. -#}
    {%- if category.rendering.preview -%}
        <div class="sds-section">
            {%- set colors = ['light', 'dark'] -%}
            {%- for color in colors -%}
                <div class="preview">
                    {%- set sizes = ['mega', 'large', 'medium', 'small', 'default'] -%}
                    {%- for size in sizes -%}
                        <div class="preview-item" data-color="{{ color }}" data-size="{{ size }}">
                            {%- include '_icon.html.twig' with {
                                iconIdentifier: icon.identifier,
                                iconSize: size,
                                iconSpinning: category.rendering.spinning
                            } -%}
                        </div>
                    {%- endfor -%}
                </div>
            {%- endfor -%}
        </div>
    {%- endif -%}

    {%- if category.rendering.menuview -%}
        <div class="sds-section">
            <h2>Module Menu Preview</h2>
            <div class="menuview">
                <div class="menuview-item">
                    {%- for colorVariant in ['light', 'dark', 'accent1', 'accent2', 'accent3'] -%}
                    <span class="modulemenu-preview" data-color="{{ colorVariant }}">
                        <span class="modulemenu-action">
                            <span class="modulemenu-icon">
                                {%- include '_icon.html.twig' with {
                                    iconIdentifier: icon.identifier,
                                    iconSize: 'medium',
                                    iconSpinning: category.rendering.spinning
                                } -%}
                            </span>
                            <span class="modulemenu-name">{{ icon.identifier }}</span>
                        </span>
                    </span>
                    {%- endfor -%}
                </div>
            </div>
        </div>
    {%- endif -%}

    {%- if category.rendering.buttons -%}
        <div class="sds-section">
            <h2>Buttons</h2>
            <div class="docs-buttons">
                <span class="sds-btn sds-btn--secondary">
                    {%- include '_icon.html.twig' with {
                        iconIdentifier: icon.identifier,
                        iconSize: 'small',
                        iconSpinning: category.rendering.spinning
                    } -%}
                </span>
                <span class="sds-btn sds-btn--primary">
                    {%- include '_icon.html.twig' with {
                        iconIdentifier: icon.identifier,
                        iconSize: 'small',
                        iconSpinning: category.rendering.spinning
                    } -%}
                </span>
            </div>
            <div class="docs-buttons">
                <span class="sds-btn sds-btn--secondary">
                    {%- include '_icon.html.twig' with {
                        iconIdentifier: icon.identifier,
                        iconSize: 'small',
                        iconSpinning: category.rendering.spinning
                    } -%}
                    Button Label
                </span>
                <span class="sds-btn sds-btn--primary">
                    {%- include '_icon.html.twig' with {
                        iconIdentifier: icon.identifier,
                        iconSize: 'small',
                        iconSpinning: category.rendering.spinning
                    } -%}
                    Button Label
                </span>
            </div>
        </div>
    {%- endif -%}

    {%- if category.rendering.buttons and icon._meta.bidi -%}
        <div class="sds-section">
            <h2>BiDi Comparison (LTR vs RTL)</h2>
            <div class="docs-cols">
                <div dir="ltr">
                    <h3>LTR (Left-to-Right)</h3>
                    <div class="docs-buttons">
                        <span class="sds-btn sds-btn--secondary">
                            {%- include '_icon.html.twig' with {
                                iconIdentifier: icon.identifier,
                                iconSize: 'small',
                                iconSpinning: category.rendering.spinning
                            } -%}
                        </span>
                        <span class="sds-btn sds-btn--primary">
                            {%- include '_icon.html.twig' with {
                                iconIdentifier: icon.identifier,
                                iconSize: 'small',
                                iconSpinning: category.rendering.spinning
                            } -%}
                        </span>
                    </div>
                    <div class="docs-buttons">
                        <span class="sds-btn sds-btn--secondary">
                            {%- include '_icon.html.twig' with {
                                iconIdentifier: icon.identifier,
                                iconSize: 'small',
                                iconSpinning: category.rendering.spinning
                            } -%}
                            Next
                        </span>
                    </div>
                </div>
                <div dir="rtl">
                    <h3>RTL (Right-to-Left)</h3>
                    <div class="docs-buttons">
                        <span class="sds-btn sds-btn--secondary">
                            {%- include '_icon.html.twig' with {
                                iconIdentifier: icon.identifier,
                                iconSize: 'small',
                                iconSpinning: category.rendering.spinning
                            } -%}
                        </span>
                        <span class="sds-btn sds-btn--primary">
                            {%- include '_icon.html.twig' with {
                                iconIdentifier: icon.identifier,
                                iconSize: 'small',
                                iconSpinning: category.rendering.spinning
                            } -%}
                        </span>
                    </div>
                    <div class="docs-buttons">
                        <span class="sds-btn sds-btn--secondary">
                            {%- include '_icon.html.twig' with {
                                iconIdentifier: icon.identifier,
                                iconSize: 'small',
                                iconSpinning: category.rendering.spinning
                            } -%}
                            التالي
                        </span>
                    </div>
                </div>
            </div>
        </div>
    {%- endif -%}

    {%- if category.rendering.overlay -%}
        <div class="sds-section">
            <div class="preview">
                {%- set mainIcons = ['apps-filetree-folder-default', 'apps-filetree-folder-temp', 'apps-pagetree-page'] -%}
                {%- for mainIcon in mainIcons -%}
                    {%- set colors = ['light', 'dark'] -%}
                    {%- for color in colors -%}
                        {%- set sizes = ['mega', 'large', 'medium', 'small', 'default'] -%}
                        {%- for size in sizes -%}
                            <div class="preview-item" data-color="{{ color }}" data-size="{{ size }}">
                                {%- include '_icon.html.twig' with {
                                    iconIdentifier: mainIcon,
                                    iconOverlayIdentifier: icon.identifier,
                                    iconSize: size,
                                    iconSpinning: category.rendering.spinning
                                } -%}
                            </div>
                        {%- endfor -%}
                    {%- endfor -%}
                {%- endfor -%}
            </div>
        </div>
    {%- endif -%}

    <div class="sds-section">
        <h2>Usage</h2>

        {%- if icon._meta.bidi -%}
        <sds-note tone="info" heading="BiDi support">
            <p>This icon uses logical naming (start/end instead of left/right) and is designed for bidirectional support. See the usage examples below for implementation details.</p>
        </sds-note>
        {%- endif -%}

        <h3>Icon Identifier</h3>
        {{ makros.codeblock(icon.identifier, 'text') }}

        <h3>Markup</h3>
        {%- if icon._meta.bidi -%}
        <p class="docs-hint">⚠ BiDi NOT supported - Raw SVG cannot be flipped. Use inline or sprite methods for BiDi support.</p>
        {%- endif -%}
        {{ makros.codeblock(icon._inline, 'xml') }}

        <h3>Inline</h3>
        {%- if icon._meta.bidi -%}
        <p class="docs-hint">✓ BiDi supported - Icon will flip in RTL mode when using the <code>icon-bidi</code> class</p>
        {%- endif -%}
        {%- set inlineusage -%}
            {%- if not category.rendering.overlay -%}
                {%- include '_icon.html.twig' with {
                    pathPrefix: '',
                    iconInline: true,
                    iconIdentifier: icon.identifier,
                    iconSize: 'small',
                    iconSpinning: category.rendering.spinning
                } -%}
            {%- else -%}
                {%- include '_icon.html.twig' with {
                    pathPrefix: '',
                    iconInline: true,
                    iconIdentifier: 'apps-pagetree-page',
                    iconOverlayIdentifier: icon.identifier,
                    iconSize: 'small',
                    iconSpinning: category.rendering.spinning
                } -%}
            {%- endif -%}
        {%- endset -%}
        {{ makros.codeblock(inlineusage) }}

        <h3>Sprite</h3>
        {%- if icon._meta.bidi -%}
        <p class="docs-hint">✓ BiDi supported - Icon will flip in RTL mode when using the <code>icon-bidi</code> class</p>
        {%- endif -%}
        {%- set spriteusage -%}
            {%- if not category.rendering.overlay -%}
                {%- include '_icon.html.twig' with {
                    pathPrefix: '',
                    iconIdentifier: icon.identifier,
                    iconSize: 'small',
                    iconSpinning: category.rendering.spinning
                } -%}
            {%- else -%}
                {%- include '_icon.html.twig' with {
                    pathPrefix: '',
                    iconIdentifier: 'apps-pagetree-page',
                    iconOverlayIdentifier: icon.identifier,
                    iconSize: 'small',
                    iconSpinning: category.rendering.spinning
                } -%}
            {%- endif -%}
        {%- endset -%}
        {{ makros.codeblock(spriteusage) }}

        <h3>TYPO3 ViewHelper</h3>
        {%- if icon._meta.bidi -%}
        <p class="docs-hint">✓ BiDi supported</p>
        {%- endif -%}
        {%- if category.rendering.overlay -%}
            {{ makros.codeblock('<core:icon identifier="apps-pagetree-page" overlay="' ~ icon.identifier ~ '" size="small" />') }}
        {%- else -%}
            {{ makros.codeblock('<core:icon identifier="' ~ icon.identifier ~ '" size="small" />') }}
        {%- endif -%}

        <h3>TYPO3 Web Component</h3>
        {%- if icon._meta.bidi -%}
        <p class="docs-hint">✓ BiDi supported</p>
        {%- endif -%}
        {%- if category.rendering.overlay -%}
            {{ makros.codeblock('<typo3-backend-icon identifier="apps-pagetree-page" overlay="' ~ icon.identifier ~ '" size="small"></typo3-backend-icon>') }}
        {%- else -%}
            {{ makros.codeblock('<typo3-backend-icon identifier="' ~ icon.identifier ~ '" size="small"></typo3-backend-icon>') }}
        {%- endif -%}

        <h3>CSS Background Image</h3>
        {%- if icon._meta.bidi -%}
        <p class="docs-hint">⚠ BiDi NOT supported - Background images cannot be flipped with CSS. Use inline or sprite methods for BiDi support.</p>
        {%- endif -%}
        {%- set cssbackgroundimageusage -%}
.myclass {
    background-size: 1em 1em;
    background-image: url("data:image/svg+xml,{{ icon._inlineEscaped|raw|replace({"fill='currentColor'": "fill='%23fff'"}) }}");
}
        {%- endset -%}
        {{ makros.codeblock(cssbackgroundimageusage, 'css') }}

        <h3>Sass Background Variable</h3>
        {%- if icon._meta.bidi -%}
        <p class="docs-hint">⚠ BiDi NOT supported - Background images cannot be flipped with CSS. Use inline or sprite methods for BiDi support.</p>
        {%- endif -%}
        {%- set sassbackgroundvariable -%}
@use "@typo3/icons/dist/icons" as *;
@use "@typo3/icons/dist/scss/icons-variables-{{ icon.category }}" as *;

.myclass {
    background-size: 1em 1em;
    background-image: $icon-{{ icon.identifier }};
}
        {%- endset -%}
        {{ makros.codeblock(sassbackgroundvariable, 'scss') }}

    </div>

    {%- if icon._meta.alias|length > 0 -%}
        <div class="sds-section">
            <h2>Alias</h2>
            <ul class="sds-list--plain">
                {%- for alias in icon._meta.alias -%}
                    <li>{{ alias }}</li>
                {%- endfor -%}
            </ul>
        </div>
    {%- endif -%}

    <div class="sds-section">
        <h2>Download</h2>
        <p>
            <sds-button href="{{ pathPrefix }}dist/{{ icon.svg }}" variant="primary">Download SVG</sds-button>
        </p>
    </div>

{% endblock %}
